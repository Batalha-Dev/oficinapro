{
  "name": "oficinapro",
  "private": true,
  "description": "OficinaPro - gestao de oficina mecanica",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "setup": "npm install --prefix backend && npm install --prefix frontend && npm run setup --prefix backend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "test": "npm test --prefix backend && npm test --prefix frontend",
    "lint": "eslint .",
    "format": "prettier --write backend frontend eslint.config.js",
    "format:check": "prettier --check backend frontend eslint.config.js",
    "demo:reset": "bash scripts/reset-demo.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
